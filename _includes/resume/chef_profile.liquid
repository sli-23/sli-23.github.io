<section class="chef-profile" aria-labelledby="chef-profile-name">
  <div class="chef-profile__visual">
    <div class="chef-profile__portrait">
      <picture>
        <source
          srcset="{{ '/assets/img/resume-table/chef-littleshrimp.webp' | relative_url }}"
          type="image/webp"
        >
        <img
          src="{{ '/assets/img/resume-table/chef-littleshrimp.png' | relative_url }}"
          alt="Chef LitteLittleShrimp wearing a white chef's hat and coat."
          width="1278"
          height="1230"
          loading="lazy"
          decoding="async"
          draggable="false"
        >
      </picture>
    </div>
  </div>

  <div class="chef-profile__copy">
    <div class="chef-profile__identity">
      <p class="chef-profile__role">Executive Chef</p>
      <h4 id="chef-profile-name">Chef LitteLittleShrimp</h4>
      <p class="chef-profile__bio">Precision · restraint · seasonality</p>
    </div>

    <a
      class="chef-profile__search"
      href="https://www.google.com/search?q=Sumikko+Gurashi+fried+shrimp+tail+Ebifurai+no+Shippo"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Search Google for Sumikko Gurashi fried shrimp tail Ebifurai no Shippo"
    >
      <span class="chef-profile__search-label">The story behind the batter</span>
      <span class="chef-profile__search-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>
